TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Where the bot sends outbound notifications (new inquiry, new subscriber).
TELEGRAM_CHAT_ID=your_group_chat_id

# Comma-separated chat IDs allowed to RUN commands (/deploy, /leads, /logs, ...).
#
# FAIL CLOSED: if this is empty AND TELEGRAM_CHAT_ID is empty, the bot refuses
# every command from everyone. That is deliberate — an unset allowlist must
# never mean "allow all". Anyone can find a bot by its @name and message it, so
# without an allowlist /leads and /subscribers would hand personal data to the
# public and /deploy would run commands on the VPS.
#
# Falls back to TELEGRAM_CHAT_ID if unset. Group IDs are negative — include the
# minus sign. Find your ID by messaging @userinfobot, or see:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[-0-9]*'
TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890

SITE_DIR=/var/www/architmittal.com

# Notification listener. Bound to 127.0.0.1 — must never be exposed publicly.
NOTIFICATION_PORT=3003

# Where refused command attempts are recorded (chat ID + command, never bodies).
BOT_AUTH_LOG=/var/www/architmittal.com/bot/auth-rejections.log
